{
  "expo": {
    "name": "CareDose",
    "slug": "caredose",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#EAF7F1",
    "scheme": "caredose",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF7F1"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#087E67"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF7F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#EAF7F1",
            "image": "./assets/splash-icon.png",
            "imageWidth": 180,
            "resizeMode": "contain"
          },
          "ios": {
            "backgroundColor": "#EAF7F1",
            "image": "./assets/splash-icon.png",
            "imageWidth": 180,
            "resizeMode": "contain"
          }
        }
      ]
    ]
  }
}
