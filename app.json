{
  "expo": {
    "name": "CareDose",
    "slug": "caredose",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "caredose",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#087E67"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ]
  }
}
